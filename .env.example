# FinSoft local environment. Copy to .env — .env is gitignored, this file is not.
#
# These are LOCAL DEVELOPMENT FIXTURES, not secrets. They are deliberately
# obvious and worthless so that nobody mistakes them for a real credential and
# so secret scanning has nothing to find. NON_NEGOTIABLES rule 20: secrets are
# never in the repository. Rule 21: agents get local and CI databases, that is
# all. A production credential must never appear in this file or in .env.

# Lets a bare `docker compose up` work from the repository root while the
# compose file lives where ARCHITECTURE.md:107 says it should.
COMPOSE_FILE=infrastructure/docker/compose.yaml

# Each git worktree should set its own project name and ports so that parallel
# agent sessions cannot collide, and `down -v` only ever destroys its own
# stack (INFRASTRUCTURE.md:257).
COMPOSE_PROJECT_NAME=finsoft

# Starts the optional local-only tooling (Adminer). Set here rather than in the
# compose file so a developer machine gets it by default and CI, which has no
# .env, does not. Remove this line to run the data plane alone.
COMPOSE_PROFILES=tools

# Exact patch versions, verified by pulling. INFRASTRUCTURE.md:57 requires the
# identical version in every environment. PostgreSQL 17 is required, not merely
# preferred: the builtin locale provider does not exist before it.
#
# Digests as pulled on 2026-09-22 —
#   postgres@sha256:dc17045ccfd343b49600570ea734b9c4991cf1c3f3302e67df51e3b402dd55c4
#   redis@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499
# INFRASTRUCTURE.md:60 wants byte-identical images by digest. Digest pinning
# lands with FND-014, where staging and production must run the same artefact.
POSTGRES_IMAGE=postgres:17.10-alpine
REDIS_IMAGE=redis:7.4.11-alpine

# Override this whole block if the machine already runs something on these
# ports — a pre-existing PostgreSQL on 5432 is common, and Redis on 6379 even
# more so. Ports are per-stack so parallel worktrees cannot collide.
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
REDIS_PORT=6379
REDIS_TEST_PORT=6380

# Adminer, the browser database UI. Local tooling only.
ADMINER_IMAGE=adminer:5-standalone
ADMINER_PORT=8088

POSTGRES_DB=finsoft
POSTGRES_TEST_DB=finsoft_test

# Container bootstrap identity. Creates the three roles below on first start
# and is never used by application code thereafter.
POSTGRES_BOOTSTRAP_USER=finsoft_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=local-dev-only-bootstrap

# The running API and worker connect as this role: no BYPASSRLS, no SUPERUSER,
# owner of nothing.
POSTGRES_APP_PASSWORD=local-dev-only-app

# Migrations only, during deploy. The one role with BYPASSRLS.
POSTGRES_MIGRATION_PASSWORD=local-dev-only-migration

# Support reads. Subject to RLS.
POSTGRES_READONLY_PASSWORD=local-dev-only-readonly

# Connection strings, assembled from the above for convenience.
DATABASE_URL=postgresql://finsoft_app:local-dev-only-app@localhost:5432/finsoft
MIGRATION_DATABASE_URL=postgresql://finsoft_migration:local-dev-only-migration@localhost:5432/finsoft
TEST_DATABASE_URL=postgresql://finsoft_app:local-dev-only-app@localhost:5433/finsoft_test
TEST_MIGRATION_DATABASE_URL=postgresql://finsoft_migration:local-dev-only-migration@localhost:5433/finsoft_test

REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=redis://localhost:6380

# The API process. Served behind the reverse proxy at /api/*, same-origin
# with the web app so ADR-0009 SameSite=Strict refresh cookies work.
API_PORT=3001
