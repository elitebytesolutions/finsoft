#!/bin/sh
#
# FinSoft pre-push hook.
#
# GitHub branch protection is unavailable on a private repository on the Free
# plan (verified: the API returns 403 "Upgrade to GitHub Pro"). This hook is
# the local substitute. It is a speed bump, not a boundary — `--no-verify`
# bypasses it, and anyone with push access can do that. It exists to make the
# wrong thing require a deliberate act rather than a moment of inattention.
#
# Two jobs:
#   1. Refuse any direct push to a protected branch, unconditionally.
#   2. On a feature branch, run the checks that are cheap locally.
#
# Job 1 is NOT "allow it once the tests pass". main and develop are reached
# through a reviewed pull request or not at all; a green test run is not a
# substitute for review, and a direct push bypasses CI entirely.
#
# Installed by `npm run hooks:install`, which the `prepare` script runs on
# every `npm install`, so a fresh clone or worktree gets it automatically.
# `npm run hooks:verify` confirms it is active.

set -e

PROTECTED="refs/heads/main refs/heads/develop"

# ---------------------------------------------------------------------------
# 1. Protected branches
#
# git feeds one line per ref being pushed on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# ---------------------------------------------------------------------------
blocked=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -z "$remote_ref" ] && continue

  for protected in $PROTECTED; do
    if [ "$remote_ref" = "$protected" ]; then
      # A delete is pushed as an all-zero local sha. Refuse those too:
      # branch deletion is the other thing protection would have blocked.
      if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        blocked="$blocked\n  deleting ${remote_ref#refs/heads/}"
      else
        blocked="$blocked\n  pushing to ${remote_ref#refs/heads/}"
      fi
    fi
  done
done

if [ -n "$blocked" ]; then
  printf '\n  REFUSED:%b\n\n' "$blocked"
  cat <<'MESSAGE'
  main and develop are reached through a reviewed pull request, never by a
  direct push. This is not about whether the tests pass — a direct push
  bypasses CI and review entirely.

      git switch -c feature/FND-0NN-what-it-does
      git push -u origin HEAD
      gh pr create --base develop

  Agents push feature branches only. They do not merge, do not push to a
  protected branch, and do not use --no-verify.

MESSAGE
  exit 1
fi

# ---------------------------------------------------------------------------
# 2. Feature-branch checks
#
# Deliberately not the full CI gate. A pre-push hook that takes minutes gets
# bypassed, and a bypassed hook protects nothing. CI runs everything; this
# catches the things that are fast and embarrassing.
#
# OPS-002: this used to inline typecheck / scoped lint / unit tests here.
# That logic now lives in tools/ci/check.mjs (`npm run check`), shared with
# CI's own fast path, so the two cannot drift apart. check.mjs also prints a
# risk-tier classification and, on a T2/T3-looking push, a NOTICE — not a
# block — to run `npm run check:full` (data plane up, the full gate) before
# opening the pull request.
# ---------------------------------------------------------------------------
printf '\n  pre-push checks (npm run check)\n\n'

if npm run check; then
  printf '\n'
else
  printf '\n  FAILED — see above\n\n'
  echo "  npm run check"
  exit 1
fi

exit 0
