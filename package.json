{
  "name": "finsoft",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @finsoft/web",
    "build": "npm run build --workspace @finsoft/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p database/tests --noEmit && tsc -p tests/security --noEmit && tsc -p tests/integration --noEmit && tsc -p tests/performance --noEmit && tsc -p tests/e2e --noEmit && tsc -p tests/accounting --noEmit && tsc -p tests/reconciliation --noEmit",
    "test": "npm run test --workspaces --if-present && npm run test:gate",
    "test:ci-tools": "node --test tools/ci/classify.test.mjs",
    "check": "node tools/ci/check.mjs",
    "check:full": "npm run db:up -- --wait && npm run verify && npm run test:e2e",
    "audit:gate": "node tools/ci/audit-gate.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps packages modules --config .dependency-cruiser.cjs",
    "verify:controls": "node tools/verify-controls.mjs",
    "verify": "npm run typecheck && npm run lint && npm run depcruise && npm run db:migrate:verify && npm run format:check && npm test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f",
    "db:verify": "node tools/db/verify.mjs",
    "db:outbox-plan": "node --env-file-if-exists=.env tools/db/outbox-plan.mjs",
    "db:psql": "docker compose exec postgres psql -U finsoft_bootstrap -d finsoft",
    "db:migrate": "node --env-file-if-exists=.env packages/database/src/migrate/cli.ts migrate",
    "db:migrate:status": "node --env-file-if-exists=.env packages/database/src/migrate/cli.ts status",
    "db:migrate:verify": "node packages/database/src/migrate/cli.ts verify",
    "db:checksums": "node packages/database/src/migrate/cli.ts checksums",
    "audit:verify": "node --env-file-if-exists=.env packages/database/src/audit/cli.ts",
    "seed:demo-tenants": "node --env-file-if-exists=.env tools/seed/demo-tenants.mjs",
    "test:gate": "npm run smoke && npm run test:schema && npm run test:security && npm run test:accounting && npm run test:reconciliation && npm run test:integration && npm run test:performance",
    "test:schema": "vitest run --dir database/tests",
    "test:security": "vitest run --dir tests/security",
    "db:codegen": "node --env-file-if-exists=.env packages/database/src/generate/cli.ts",
    "db:migrate:test": "node --env-file-if-exists=.env packages/database/src/testing/cli.ts migrate",
    "test:accounting": "vitest run --dir tests/accounting",
    "test:financial-invariant-suite": "vitest run tests/accounting/financial-invariant-suite.spec.ts",
    "test:reconciliation": "vitest run --dir tests/reconciliation",
    "smoke": "node tools/smoke/runtime.mjs",
    "hooks:install": "node tools/hooks/install.mjs",
    "hooks:verify": "node tools/hooks/verify.mjs",
    "prepare": "node tools/hooks/install.mjs",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:performance": "vitest run --dir tests/performance",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.8",
    "typescript-eslint": "8.70.1",
    "unplugin-swc": "2.0.0"
  }
}
