{
  "name": "finsoft",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @finsoft/web",
    "build": "npm run build --workspace @finsoft/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p database/tests --noEmit && tsc -p tests/security --noEmit && tsc -p tests/accounting --noEmit",
    "test": "npm run test --workspaces --if-present && npm run test:gate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "verify": "npm run typecheck && npm run lint && npm run depcruise && npm run format:check && npm test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f",
    "db:verify": "node tools/db/verify.mjs",
    "db:psql": "docker compose exec postgres psql -U finsoft_bootstrap -d finsoft",
    "db:migrate": "node --env-file-if-exists=.env packages/database/src/migrate/cli.ts migrate",
    "db:migrate:status": "node --env-file-if-exists=.env packages/database/src/migrate/cli.ts status",
    "db:migrate:verify": "node packages/database/src/migrate/cli.ts verify",
    "db:checksums": "node packages/database/src/migrate/cli.ts checksums",
    "test:gate": "npm run smoke && npm run test:schema && npm run test:security && npm run test:accounting",
    "test:schema": "vitest run --dir database/tests",
    "test:security": "vitest run --dir tests/security",
    "db:codegen": "node --env-file-if-exists=.env packages/database/src/generate/cli.ts",
    "db:migrate:test": "node --env-file-if-exists=.env packages/database/src/testing/cli.ts migrate",
    "test:accounting": "vitest run --dir tests/accounting",
    "smoke": "node tools/smoke/runtime.mjs"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.8",
    "typescript-eslint": "8.70.1"
  }
}
