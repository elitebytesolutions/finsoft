# Staging reverse proxy.
#
# A proxy is required here regardless of TLS, and not as a convenience: the web
# app and the API must be SAME-ORIGIN. ADR-0009's refresh cookie is
# SameSite=Strict, which a cross-origin call from :3000 to :3001 would not
# send. So the browser sees one origin and `/api/*` is routed behind it,
# exactly as production does.
#
# HTTPS, on the temporary hostname `31-220-74-159.sslip.io` (PRD §6.1: "Staging
# over HTTPS ... the real domain later"). sslip.io resolves
# `<anything>.31-220-74-159.sslip.io` — and the bare form used here —
# to 31.220.74.159 with no DNS setup of our own; it exists precisely so a box
# reached by IP can still present a real hostname to Caddy and to Let's
# Encrypt, which will not issue a certificate for a bare IP address. Caddy's
# automatic HTTPS then applies to a site block that names a host: it obtains
# and renews the certificate itself and — because this block is not an
# explicit `:80` — it ALSO opens :80 on its own and serves the HTTP->HTTPS
# redirect there, so no separate redirect block is written here to (fail to)
# keep in sync with this one.
31-220-74-159.sslip.io {
	# Caddy's own access log, as JSON, so it lands in the same shape as the
	# application's structured logs (ADR-0016) rather than as a second format
	# an aggregator has to be taught.
	log {
		output stdout
		format json
	}

	# The API, including its health probes at /api/health and
	# /api/health/ready. Path-routed, not rewritten: apps/api sets a global
	# prefix of /api so the proxy can route on path alone, and a probe travels
	# the same path as real traffic — which is the point of a probe.
	handle /api/* {
		reverse_proxy api:3001
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy web:3000
	}

	# A bare 502 from a proxy says nothing about which side is down. This says
	# which, so the first question during an incident is already answered.
	handle_errors {
		@web_down expression {err.status_code} in [502, 503]
		respond @web_down `FinSoft staging — the web application is not responding.

The proxy is up. Check /api/health: if that answers, the API is healthy and
the fault is in the web container alone.
` 503
	}
}
